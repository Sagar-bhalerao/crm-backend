# Copy to .env and fill in your local values. Never commit .env.
NODE_ENV=development
PORT=5000

# PostgreSQL (database must already exist)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm
DB_USER=postgres
DB_PASSWORD=your_password
# Set to true only if your server requires SSL (most local installs do not)
DB_SSL=false

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Run pending schema migrations automatically when the server boots
AUTO_MIGRATE=true
